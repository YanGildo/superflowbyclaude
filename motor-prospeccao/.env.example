# Copie para .env  (Windows: copy .env.example .env)  e troque a senha.

# Senha que o Superflow manda em toda chamada. Use algo longo e aleatório.
MOTOR_SENHA=troque-esta-senha-por-uma-longa

# Porta no seu PC. 8090 para não brigar com o Superflow local (8080).
MOTOR_PORTA=8090

# Sites que podem usar o motor (expressão regular). O padrão libera o Superflow local e *.vercel.app.
# Com domínio próprio, adicione:  |^https://app\.seudominio\.com\.br$$
# MOTOR_ORIGENS=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$$|^https://[a-z0-9-]+\.vercel\.app$$

# Buscas em paralelo dentro de um job (4 é o padrão do kit). Diminua se o Google bloquear.
# MOTOR_WORKERS=4

# Só num servidor: escuta em todas as interfaces (ponha HTTPS na frente, ex.: Caddy ou Cloudflare Tunnel).
# MOTOR_BIND=0.0.0.0
